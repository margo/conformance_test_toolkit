  {
    "id": "rd-03-desired-state",
    "name": "Real device \u2014 desired state, fetch and status",
    "description": "The device reads its desired-state manifest, fetches the bundle or the deployment it lists by digest, reports the status of the deployment with the manifest version it adopted, and re-reads with the ETag of that manifest.",
    "crIds": [
      "MARGO-DEV-MGMT-001",
      "MARGO-DEV-MGMT-049",
      "MARGO-DEV-MGMT-059",
      "MARGO-DEV-MGMT-062",
      "MARGO-DEV-MGMT-066",
      "MARGO-DEV-MGMT-067",
      "MARGO-DEV-MGMT-068",
      "MARGO-DEV-MGMT-070",
      "MARGO-DEV-MGMT-071",
      "MARGO-DEV-MGMT-072",
      "MARGO-DEV-MGMT-073",
      "MARGO-DEV-MGMT-074",
      "MARGO-DEV-MGMT-076",
      "MARGO-DEV-MGMT-077",
      "MARGO-DEV-MGMT-078",
      "MARGO-DEV-MGMT-079",
      "MARGO-DEV-MGMT-080",
      "MARGO-DEV-MGMT-082"
    ],
    "steps": [
      {
        "id": "rd-03-desired-state-connected",
        "name": "The device is connected to the mock WFM",
        "observe": {
          "path_regex": "^/api/v1/",
          "status": [
            200,
            201,
            204,
            304,
            400,
            403,
            404,
            406,
            422
          ],
          "within_seconds": 120
        },
        "extract_context": {
          "deviceClient": "client",
          "deviceCert": "cert.sha256"
        }
      },
      {
        "id": "rd-03-desired-state-read",
        "name": "The device reads the desired-state manifest",
        "crIds": [
          "MARGO-DEV-MGMT-001"
        ],
        "observe": {
          "method": "GET",
          "path_regex": "^/api/v1/deployments$",
          "status": [
            200,
            304
          ],
          "within_seconds": 180
        }
      },
      {
        "id": "rd-03-desired-state-accept",
        "name": "The device requests the manifest with Accept: application/vnd.margo.manifest.v1+json",
        "crIds": [
          "MARGO-DEV-MGMT-062"
        ],
        "observe": {
          "method": "GET",
          "path_regex": "^/api/v1/deployments$",
          "status": [
            200,
            304
          ],
          "check": [
            {
              "field": "headers.Accept",
              "operation": "contains",
              "value": "application/vnd.margo.manifest.v1+json"
            }
          ],
          "within_seconds": 180
        }
      },
      {
        "id": "rd-03-desired-state-fetch",
        "name": "The device fetches the bundle or a deployment by its digest",
        "crIds": [
          "MARGO-DEV-MGMT-001"
        ],
        "observe": {
          "method": "GET",
          "path_regex": "^/api/v1/(bundles|deployments/[^/]+)/sha256:[0-9a-f]+$",
          "status": [
            200,
            304
          ],
          "within_seconds": 240
        }
      },
      {
        "id": "rd-03-desired-state-digest-exact",
        "name": "The device fetches by the digest exactly as the manifest gives it (no prefix, suffix or whitespace)",
        "crIds": [
          "MARGO-DEV-MGMT-059"
        ],
        "observe": {
          "method": "GET",
          "path_regex": "^/api/v1/(bundles|deployments/[^/]+)/",
          "status": [
            200,
            304
          ],
          "check": [
            {
              "field": "path",
              "operation": "matches_regex",
              "value": "^/api/v1/(bundles|deployments/[0-9a-fA-F-]+)/sha256:[0-9a-f]{64}$"
            }
          ],
          "within_seconds": 240
        }
      },
      {
        "id": "rd-03-desired-state-status",
        "name": "The device reports the deployment status and the report passes the mock WFM's validation",
        "crIds": [
          "MARGO-DEV-MGMT-066"
        ],
        "observe": {
          "method": "POST",
          "path_regex": "^/api/v1/deployments/[^/]+/status$",
          "status": [
            200,
            201
          ],
          "within_seconds": 300
        }
      },
      {
        "id": "rd-03-desired-state-status-route-uuid",
        "name": "The status route carries the deployment UUID",
        "crIds": [
          "MARGO-DEV-MGMT-067"
        ],
        "observe": {
          "method": "POST",
          "path_regex": "^/api/v1/deployments/[^/]+/status$",
          "status": [
            200,
            201,
            422
          ],
          "within_seconds": 30,
          "check": [
            {
              "field": "path",
              "operation": "matches_regex",
              "value": "^/api/v1/deployments/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/status$"
            }
          ]
        }
      },
      {
        "id": "rd-03-desired-state-status-deployment-id",
        "name": "The status report includes deploymentId",
        "crIds": [
          "MARGO-DEV-MGMT-068"
        ],
        "observe": {
          "method": "POST",
          "path_regex": "^/api/v1/deployments/[^/]+/status$",
          "status": [
            200,
            201,
            422
          ],
          "within_seconds": 30,
          "check": [
            {
              "field": "expectations.status-deployment-id",
              "operation": "equals",
              "value": "pass"
            }
          ]
        }
      },
      {
        "id": "rd-03-desired-state-status-adopted-version",
        "name": "The status report includes adoptedManifestVersion",
        "crIds": [
          "MARGO-DEV-MGMT-070"
        ],
        "observe": {
          "method": "POST",
          "path_regex": "^/api/v1/deployments/[^/]+/status$",
          "status": [
            200,
            201,
            422
          ],
          "within_seconds": 30,
          "check": [
            {
              "field": "expectations.status-adopted-manifest-version",
              "operation": "equals",
              "value": "pass"
            }
          ]
        }
      },
      {
        "id": "rd-03-desired-state-status-status",
        "name": "The status report includes status",
        "crIds": [
