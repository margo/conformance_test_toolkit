          "within_seconds": 5,
          "check": [
            {
              "field": "expectations.device-runtime-oci",
              "operation": "equals",
              "value": "pass"
            }
          ],
          "where": [
            {
              "field": "expectations.device-role-standalone-device",
              "operation": "equals",
              "value": "pass"
            }
          ],
          "if_absent": "skip",
          "skip_reason": "the device does not report the compose deployment type"
        }
