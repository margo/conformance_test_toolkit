  {
    "id": "rd-17-eligibility",
    "name": "Real device \u2014 a deployment whose eligibility rules the device does not meet is not deployed",
    "description": "The mock WFM assigns a deployment whose deviceConstraints.eligibilityRules require the label ctt.margo.org/no-device-reports-this-label, which no device reports. The device must evaluate the rule before deploying and must not deploy the workload: it must not report installing or installed for it. Judged only when the device reports installing or installed for a deployment at all; a device that reports only pending or failed gives no evidence either way.",
    "crIds": [
      "MARGO-DEV-MGMT-051"
    ],
    "steps": [
      {
        "id": "rd-17-eligibility-connected",
        "name": "The device is connected to the mock WFM",
        "observe": {
          "path_regex": "^/api/v1/",
          "status": [
            200,
            201,
            204,
            304,
            400,
            403,
            404,
            406,
            422
          ],
          "within_seconds": 120
        },
        "extract_context": {
          "deviceClient": "client",
          "deviceCert": "cert.sha256"
        }
      },
      {
        "id": "rd-17-eligibility-arm",
        "name": "Mock WFM: assign deployment 5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e09 whose eligibility rules the device does not meet",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments?client={deviceClient}",
        "mtls": true,
        "request_body": {
          "deploymentIds": [
            "a3e2f5dc-912e-494f-8395-52cf3769bc06",
            "5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e09"
          ]
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          }
        ],
        "extract_context": {
          "newVersion": "manifestVersion"
        }
      },
      {
        "id": "rd-17-eligibility-not-deployed",
        "name": "The device does not deploy the workload (no installing or installed status for it)",
        "crIds": [
          "MARGO-DEV-MGMT-051"
        ],
        "observe": {
          "expect": "absent",
          "method": "POST",
          "path_regex": "^/api/v1/deployments/5f0c1c1e-2b7a-4c58-9d3e-1a2b3c4d5e09/status$",
          "where": [
            {
              "field": "body.status.state",
              "operation": "one_of",
              "value": [
                "installing",
                "installed"
              ]
            }
          ],
          "only_if": {
            "method": "POST",
            "path_regex": "^/api/v1/deployments/[^/]+/status$",
            "where": [
              {
                "field": "body.status.state",
                "operation": "one_of",
                "value": [
                  "installing",
                  "installed"
                ]
              }
            ]
          },
          "only_if_reason": "the device reported no deployment as installing or installed in this window, so whether it deployed the ineligible one cannot be seen",
          "after_polls": 2,
          "within_seconds": 300,
          "settle_seconds": 30
        }
      },
      {
        "id": "rd-17-eligibility-restore",
        "name": "Mock WFM: restore the default desired state",
        "method": "PUT",
        "endpoint": "/api/v1/test/deployments?client={deviceClient}",
        "mtls": true,
        "request_body": {
          "deploymentIds": [
            "a3e2f5dc-912e-494f-8395-52cf3769bc06"
          ]
        },
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          }
        ],
        "extract_context": {
          "newVersion": "manifestVersion"
        }
      }
    ]
  }
