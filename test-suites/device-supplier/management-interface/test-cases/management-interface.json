[
  {
    "id": "rd-02-capabilities",
    "name": "Real device \u2014 capabilities",
    "description": "The device reports its capabilities. The mock WFM validates the report against the rules of assertions.json (endpoint rules and device_expectations); each step reads one of those verdicts.",
    "crIds": [
      "MARGO-DEV-DEVREQ-004",
      "MARGO-DEV-DEVREQ-005",
      "MARGO-DEV-DEVREQ-006",
      "MARGO-DEV-DEVREQ-007",
      "MARGO-DEV-DEVREQ-008",
      "MARGO-DEV-DEVREQ-010",
      "MARGO-DEV-DEVREQ-011",
      "MARGO-DEV-EXT-001",
      "MARGO-DEV-EXT-003",
      "MARGO-DEV-EXT-004",
      "MARGO-DEV-MGMT-016",
      "MARGO-DEV-MGMT-018",
      "MARGO-DEV-MGMT-019",
      "MARGO-DEV-MGMT-020",
      "MARGO-DEV-MGMT-021",
      "MARGO-DEV-MGMT-022",
      "MARGO-DEV-MGMT-023",
      "MARGO-DEV-MGMT-024",
      "MARGO-DEV-MGMT-025",
      "MARGO-DEV-MGMT-027",
      "MARGO-DEV-MGMT-029",
      "MARGO-DEV-MGMT-030",
      "MARGO-DEV-MGMT-031",
      "MARGO-DEV-MGMT-032",
      "MARGO-DEV-MGMT-035"
    ],
    "steps": [
      {
        "id": "rd-02-capabilities-connected",
        "name": "The device is connected to the mock WFM",
        "observe": {
          "path_regex": "^/api/v1/",
          "status": [
            200,
            201,
            204,
            304,
            400,
            403,
            404,
            406,
            422
          ],
          "within_seconds": 120
        },
        "extract_context": {
          "deviceClient": "client",
          "deviceCert": "cert.sha256"
        }
      },
      {
        "id": "rd-02-capabilities-accepted",
        "name": "The device reports its capabilities and the report passes the mock WFM's validation",
        "crIds": [
          "MARGO-DEV-MGMT-016"
        ],
        "observe": {
          "method": "PUT",
          "path_regex": "^/api/v1/capabilities/[^/]+$",
          "status": [
            200,
            201
          ],
          "within_seconds": 60,
          "check": []
        },
        "extract_context": {
          "reportedDeviceId": "body.properties.id"
        }
      },
      {
        "id": "rd-02-capabilities-device-id",
        "name": "The device ID in the request path is the ID in the report",
        "crIds": [
          "MARGO-DEV-MGMT-018"
        ],
        "observe": {
          "method": "PUT",
          "path_regex": "^/api/v1/capabilities/[^/]+$",
          "status": [
            200,
            201
          ],
          "within_seconds": 60,
          "check": [
            {
              "field": "expectations.device-id",
              "operation": "equals",
              "value": "pass"
            },
            {
              "field": "path",
              "operation": "contains",
              "value": "{reportedDeviceId}"
            }
          ]
        }
      },
      {
        "id": "rd-02-capabilities-runtime",
        "name": "A device supporting Compose provides an OCI container runtime",
        "crIds": [
          "MARGO-DEV-DEVREQ-011"
        ],
        "observe": {
          "method": "PUT",
          "path_regex": "^/api/v1/capabilities/[^/]+$",
          "status": [
