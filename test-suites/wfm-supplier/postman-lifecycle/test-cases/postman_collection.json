    {
      "id": "cd962676-6633-4ee0-bb06-f8099bc26ddf",
      "name": "GET Deployments — Manifest structure and ETag",
      "request": {
        "method": "GET",
        "description": "",
        "url": {
          "raw": "{{baseUrl}}/api/v1/deployments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "deployments"
          ],
          "query": [],
          "variable": []
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.margo.manifest.v1+json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"manifestVersion is a number\", function () { pm.expect(pm.response.json().manifestVersion).to.be.a(\"number\"); });",
              "pm.test(\"deployments is an array\", function () { pm.expect(pm.response.json().deployments).to.be.an(\"array\"); });",
              "const body = pm.response.json();",
              "pm.environment.set('manifestVersion', body.manifestVersion);",
              "if (pm.response.headers.get('ETag')) { pm.environment.set('manifestEtag', pm.response.headers.get('ETag')); }",
              "if (body.deployments && body.deployments.length > 0) {",
              "    pm.environment.set('deploymentId', body.deployments[0].deploymentId);",
              "    pm.environment.set('deploymentDigest', body.deployments[0].digest);",
              "}",
              "if (body.bundle) { pm.environment.set('bundleDigest', body.bundle.digest); }"
            ]
          }
        }
      ],
      "response": [],
      "crIds": [
        "MARGO-WFM-MANAGEMENTINTERFACE-004",
        "MARGO-WFM-MANAGEMENTINTERFACE-006",
        "MARGO-WFM-MANAGEMENTINTERFACE-007",
        "MARGO-WFM-MANAGEMENTINTERFACE-027",
        "MARGO-WFM-MANAGEMENTINTERFACE-034"
      ],
      "expected_status": 200,
      "validations": [
        {
          "field": "manifestVersion",
          "operation": "is_number"
        },
        {
          "field": "deployments",
          "operation": "is_array"
        },
        {
          "operation": "etag_is_body_digest"
        },
        {
          "field": "_headers.cache-control",
          "operation": "contains",
          "value": "private"
        }
      ]
    },
