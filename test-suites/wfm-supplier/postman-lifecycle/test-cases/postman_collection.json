{
  "info": {
    "_postman_id": "d2c5fbf6-0b87-4108-a709-f73c810ea74f",
    "name": "Margo WFM Supplier — Positive Conformance Tests (rc.3)",
    "description": "Positive tests for the WFM Supplier persona on Margo 1.0.0-rc.3, written as a Postman collection: report capabilities, read the desired state, fetch the deployment and the bundle, report deployment status. Every request is sent over mTLS with the X.509-SVID set up in the CTT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "id": "c13d8721-967c-4eae-b165-9f6bb3a198c8",
      "name": "PUT Capabilities — Initial device registration",
      "request": {
        "method": "PUT",
        "description": "The first report creates the device (201). 200 is also accepted, so the collection can be run again.",
        "url": {
          "raw": "{{baseUrl}}/api/v1/capabilities/:deviceId",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "capabilities",
            ":deviceId"
          ],
          "query": [],
          "variable": [
            {
              "key": "deviceId",
              "value": "{{deviceId}}"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"properties\": {\n    \"id\": \"{{deviceId}}\",\n    \"vendor\": \"ConformanceTestVendor\",\n    \"modelNumber\": \"MDL-CONFORM-001\",\n    \"serialNumber\": \"SN-CONFORM-0001\",\n    \"cpus\": [{ \"cores\": 4, \"architecture\": \"amd64\" }],\n    \"memory\": \"8Gi\",\n    \"storage\": \"64Gi\",\n    \"interfaces\": [{ \"type\": \"ethernet\" }],\n    \"peripherals\": [],\n    \"otelCollector\": false,\n    \"supportedRuntimes\": [\"oci\"],\n    \"supportedDeploymentTypes\": [\"helm\", \"compose\"]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ],
      "response": [],
      "crIds": [
        "MARGO-WFM-MANAGEMENTINTERFACE-023"
      ],
      "expected_status": 201,
      "accepted_statuses": [
        200
      ]
    },
