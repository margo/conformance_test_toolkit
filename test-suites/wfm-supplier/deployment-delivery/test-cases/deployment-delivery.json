      "MARGO-WFM-MGMT-093",
      "MARGO-WFM-MGMT-094",
      "MARGO-WFM-MGMT-103"
    ],
    "description": "A WFM serves a multi-component compose ApplicationDeployment faithfully, without anything being deployed: content-addressed URLs, the deployment YAML and its digest, the bundle archive with exactly the listed YAML files, its cache headers, wrong digests answered 404, and status reports for every state, with invalid reports rejected. PRECONDITION: a deployment with two components (wait: true and wait: false) is assigned to the CTT's device while the second step is polling.",
    "steps": [
      {
        "id": "f55c84c8-3c29-4cd0-b11a-49bde4aeafe4",
        "name": "Report Capabilities (compose + helm supported)",
        "method": "PUT",
        "endpoint": "/api/v1/capabilities/wfm-core-device",
        "mtls": true,
        "request_body": {
          "properties": {
            "id": "wfm-core-device",
            "vendor": "Conformance Test Suite",
            "modelNumber": "CTS-MULTICOMPONENT-1",
            "serialNumber": "SN-MULTICOMPONENT-001",
            "cpus": [
              {
                "cores": 4,
                "architecture": "amd64"
              }
            ],
            "memory": "8Gi",
            "storage": "64Gi",
            "peripherals": [],
            "interfaces": [
              {
                "type": "ethernet"
              }
            ],
            "otelCollector": false,
            "supportedRuntimes": [
              "oci"
            ],
            "supportedDeploymentTypes": [
              "helm",
              "compose"
            ]
          }
        },
        "headers": {},
        "expected_status": 201,
        "validations": [],
        "extract_context": {},
        "accepted_statuses": [
          200
        ],
        "crIds": [
          "MARGO-WFM-MGMT-001"
        ]
      },
      {
        "id": "efd8ad9d-1a6f-4b12-bf9d-040f11eddec6",
        "name": "Wait For The Multi-Component Deployment To Be Assigned To The CTT's Client",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "poll": {
          "interval_seconds": 10,
          "timeout_seconds": 300,
          "until": [
            {
              "field": "deployments",
              "operation": "array_length_gte",
              "value": 1
            }
          ],
          "instruct": [
            "The WFM lists no deployment for the CTT's client yet: {cttClientSpiffeId}",
            "The steps of this scenario need one. Assign it now, in a second terminal or in your WFM's console; the run continues by itself:",
            "  - Sandbox Symphony:  bash {fixturesDir}/provision-multi-component.sh",
            "  - Your own WFM:      in its console or operator API, assign an application deployment to that client.",
            "                       It needs two components, one 'wait: true' and one 'wait: false'",
            "                       (see {fixturesDir}/multi-component-app-deployment.yaml).",
            "If nothing is assigned in time, the steps of this scenario are reported as NOT RUN."
          ],
          "on_timeout": "skip_scenario",
          "skip_reason": "no application deployment for the CTT's client ({cttClientSpiffeId}) appeared within 5 minutes, so deployment delivery was not judged. Assign one in the WFM and run the group again (sandbox Symphony: provision-multi-component.sh). If one was assigned, the WFM does not list it in GET /api/v1/deployments."
        },
        "validations": [
          {
            "field": "deployments",
            "operation": "array_length_gte",
            "value": 1
          },
          {
            "field": "manifestVersion",
            "operation": "is_number"
          },
          {
            "operation": "bundle_media_type"
          },
          {
            "field": "_headers.etag",
            "operation": "matches_regex",
            "value": "^\"sha256:[0-9a-f]{64}\"$"
          }
        ],
        "extract_context": {
          "deploymentId": "deployments.0.deploymentId",
          "deploymentDigest": "deployments.0.digest",
          "manifestVersion": "manifestVersion",
          "manifestDeployments": "deployments"
        },
        "crIds": [
          "MARGO-WFM-MGMT-040",
          "MARGO-WFM-MGMT-085"
        ]
      },
