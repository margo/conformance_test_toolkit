[
  {
    "id": "wfm-otel-observability",
    "name": "OTEL Observability — WFM Accepts Device with otelCollector Capability",
    "description": "The otelCollector capability: the WFM accepts a device that reports a collector and one that reports none, and rejects a value that is not a boolean. Whether telemetry reaches the WFM's observability backend is not checked here.",
    "crIds": [
      "MARGO-WFM-MANAGEMENTINTERFACE-023"
    ],
    "steps": [
      {
        "id": "wfm-otel-cap-1",
        "name": "Report Capabilities With otelCollector: true — Accepted",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-023"
        ],
        "method": "PUT",
        "endpoint": "/api/v1/capabilities/wfm-core-device",
        "mtls": true,
        "request_body": {
          "properties": {
            "id": "wfm-core-device",
            "vendor": "Acme Corp",
            "modelNumber": "ACM-OTEL",
            "serialNumber": "SN-OTEL-001",
            "cpus": [
              {
                "cores": 4,
                "architecture": "amd64"
              }
            ],
            "memory": "8Gi",
            "storage": "64Gi",
            "interfaces": [
              {
                "type": "ethernet"
              }
            ],
            "otelCollector": true,
            "supportedRuntimes": [
              "oci"
            ],
            "supportedDeploymentTypes": [
              "compose"
            ]
          }
        },
        "headers": {},
        "expected_status": 200,
        "accepted_statuses": [
          200,
          201
        ],
        "validations": [],
        "extract_context": {}
      },
      {
        "id": "wfm-otel-cap-2",
        "name": "Report Capabilities With otelCollector: false — Accepted",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-023"
        ],
        "method": "PUT",
        "endpoint": "/api/v1/capabilities/wfm-core-device",
        "mtls": true,
        "request_body": {
          "properties": {
            "id": "wfm-core-device",
            "vendor": "Acme Corp",
            "modelNumber": "ACM-OTEL",
            "serialNumber": "SN-OTEL-001",
            "cpus": [
              {
                "cores": 4,
                "architecture": "amd64"
              }
            ],
            "memory": "8Gi",
            "storage": "64Gi",
            "interfaces": [
              {
                "type": "ethernet"
              }
            ],
            "otelCollector": false,
            "supportedRuntimes": [
              "oci"
            ],
            "supportedDeploymentTypes": [
              "compose",
              "helm"
            ]
          }
        },
        "headers": {},
        "expected_status": 200,
        "accepted_statuses": [
          200,
          201
        ],
        "validations": [],
        "extract_context": {}
      },
      {
        "id": "wfm-otel-cap-3",
        "name": "Reject Capabilities — otelCollector Is Not A Boolean",
        "crIds": [
          "MARGO-WFM-MANAGEMENTINTERFACE-023"
        ],
        "method": "PUT",
        "endpoint": "/api/v1/capabilities/wfm-core-device",
        "mtls": true,
        "request_body": {
          "properties": {
            "id": "wfm-core-device",
            "vendor": "Acme Corp",
            "modelNumber": "ACM-OTEL",
            "serialNumber": "SN-OTEL-001",
            "cpus": [
              {
                "cores": 4,
                "architecture": "amd64"
              }
            ],
            "memory": "8Gi",
            "storage": "64Gi",
            "interfaces": [
              {
                "type": "ethernet"
              }
            ],
            "otelCollector": "yes",
            "supportedRuntimes": [
              "oci"
            ],
            "supportedDeploymentTypes": [
              "compose",
              "helm"
            ]
          }
        },
        "headers": {},
        "expected_status": 422,
        "accepted_statuses": [
          400
        ],
        "validations": [
          {
            "field": "_headers.content-type",
            "operation": "contains",
            "value": "application/problem+json"
          },
          {
            "field": "type",
            "operation": "not_empty"
          }
        ],
        "extract_context": {}
      }
    ]
  }
]
