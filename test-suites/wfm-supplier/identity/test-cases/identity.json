        "tls_max_version": "TLSv1.2",
        "tls_sigalgs": "rsa_pkcs1_sha256:rsa_pkcs1_sha384:rsa_pkcs1_sha512:ecdsa_secp256r1_sha256:ecdsa_secp384r1_sha384",
        "expect_transport_error": true,
        "not_run_if": {
