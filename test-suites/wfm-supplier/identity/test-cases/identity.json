        "crIds": [
          "MARGO-WFM-IDENT-120"
        ],
        "method": "PUT",
        "endpoint": "/api/v1/capabilities/wfm-core-device",
        "mtls": true,
        "headers": {},
        "expected_status": 0,
        "validations": [],
        "extract_context": {},
        "request_body": {
          "properties": {
            "id": "wfm-core-device",
            "vendor": "Conformance Test Suite",
            "modelNumber": "CTS-WFMCORE-1",
            "serialNumber": "SN-WFMCORE-001",
            "cpus": [
              {
                "cores": 4,
                "architecture": "amd64"
              }
            ],
            "memory": "16Gi",
            "storage": "256Gi",
            "interfaces": [
              {
                "type": "ethernet"
              }
            ],
            "peripherals": [],
            "otelCollector": true,
            "supportedRuntimes": [
              "oci"
            ],
            "supportedDeploymentTypes": [
              "compose"
            ]
          }
        },
        "expect_transport_error": true,
        "accepted_statuses": [
          401,
          403
        ],
        "svid_source": "none"
      },
      {
        "id": "wfm-identity-ca-nocert-deployments",
        "name": "No Client Certificate — GET Desired State Manifest Is Refused",
