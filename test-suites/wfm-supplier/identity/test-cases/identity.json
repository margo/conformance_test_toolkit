        "crIds": [
          "MARGO-WFM-IDENT-004"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "_tls.ec.curve",
            "operation": "one_of",
            "value": [
              "prime256v1",
              "secp384r1"
            ]
          }
        ],
        "extract_context": {},
        "applies_if": {
          "field": "_tls.ec",
          "reason": "the WFM's SVID key is not ECDSA"
        }
      },
      {
        "id": "wfm-identity-tls-eddsa-curve",
        "name": "WFM EdDSA Key Uses Ed25519",
        "crIds": [
          "MARGO-WFM-IDENT-005"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "_tls.eddsa.type",
            "operation": "equals",
            "value": "ed25519"
          }
        ],
        "extract_context": {},
        "applies_if": {
          "field": "_tls.eddsa",
          "reason": "the WFM's SVID key is not EdDSA"
        }
      },
      {
        "id": "wfm-identity-tls-rsa-bits",
        "name": "WFM RSA Key Modulus Is At Least 3072 Bits",
        "crIds": [
          "MARGO-WFM-IDENT-006"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "_tls.rsa.bits",
            "operation": "gte",
            "value": 3072
          }
        ],
        "extract_context": {},
        "applies_if": {
          "field": "_tls.rsa",
          "reason": "the WFM's SVID key is not RSA"
        }
      },
      {
        "id": "wfm-identity-tls-rsa-sha256",
        "name": "RSA Signature On The WFM SVID Uses SHA-256",
        "crIds": [
          "MARGO-WFM-IDENT-007"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "_tls.rsaSignature",
            "operation": "matches_regex",
            "value": "[Ss][Hh][Aa]256"
          }
        ],
        "extract_context": {},
        "applies_if": {
          "field": "_tls.rsaSignature",
          "reason": "the WFM's SVID is not signed with RSA"
        }
      },
