{
  "info": {
    "_postman_id": "a7e1c3f5-2b4d-4e6f-8a90-b1c2d3e4f506",
    "name": "Margo WFM Supplier — Negative Conformance Tests (rc.3)",
    "description": "Negative tests for the WFM Supplier persona on Margo 1.0.0-rc.3, written as a Postman collection: requests the WFM must reject, each with the problem details it must answer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "id": "9d0f2c1e-5b7a-4c3d-8e21-0a6b4f7c9d10",
      "name": "PUT Capabilities — Register the device (setup)",
      "request": {
        "method": "PUT",
        "description": "",
        "url": {
          "raw": "{{baseUrl}}/api/v1/capabilities/:deviceId",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "capabilities",
            ":deviceId"
          ],
          "query": [],
          "variable": [
            {
              "key": "deviceId",
              "value": "{{deviceId}}"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"properties\": {\n    \"id\": \"{{deviceId}}\",\n    \"vendor\": \"ConformanceTestVendor\",\n    \"modelNumber\": \"MDL-CONFORM-001\",\n    \"serialNumber\": \"SN-CONFORM-0001\",\n    \"cpus\": [{ \"cores\": 4, \"architecture\": \"amd64\" }],\n    \"memory\": \"8Gi\",\n    \"storage\": \"64Gi\",\n    \"interfaces\": [{ \"type\": \"ethernet\" }],\n    \"peripherals\": [],\n    \"otelCollector\": false,\n    \"supportedRuntimes\": [\"oci\"],\n    \"supportedDeploymentTypes\": [\"helm\", \"compose\"]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ],
      "response": [],
      "crIds": [
        "MARGO-WFM-MANAGEMENTINTERFACE-023"
      ],
      "expected_status": 201,
      "accepted_statuses": [
        200
      ]
    },
    {
      "id": "cce2e8d1-dde4-41b0-893d-6b988c353b91",
      "name": "PUT Capabilities — Unknown deployment type is rejected",
      "request": {
        "method": "PUT",
        "description": "",
        "url": {
          "raw": "{{baseUrl}}/api/v1/capabilities/:deviceId",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "capabilities",
            ":deviceId"
          ],
          "query": [],
          "variable": [
            {
              "key": "deviceId",
              "value": "{{deviceId}}"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"properties\": {\n    \"id\": \"{{deviceId}}\",\n    \"vendor\": \"ConformanceTestVendor\",\n    \"modelNumber\": \"MDL-CONFORM-001\",\n    \"serialNumber\": \"SN-CONFORM-0001\",\n    \"cpus\": [{ \"cores\": 4, \"architecture\": \"amd64\" }],\n    \"memory\": \"8Gi\",\n    \"storage\": \"64Gi\",\n    \"interfaces\": [{ \"type\": \"ethernet\" }],\n    \"peripherals\": [],\n    \"otelCollector\": false,\n    \"supportedRuntimes\": [\"oci\"],\n    \"supportedDeploymentTypes\": [\"not-a-deployment-type\"]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 422\", function () {",
              "    pm.response.to.have.status(422);",
              "});"
            ]
          }
        }
      ],
      "response": [],
      "crIds": [
        "MARGO-WFM-MANAGEMENTINTERFACE-023"
      ],
      "expected_status": 422,
      "validations": [
        {
          "field": "_headers.content-type",
          "operation": "contains",
          "value": "application/problem+json"
        },
        {
          "field": "type",
          "operation": "not_empty"
        }
      ]
    },
    {
      "id": "3b8e6a2f-1c4d-4f9a-b7e5-2d0c9a8f6e31",
      "name": "GET Deployments — Read the manifest (setup)",
      "request": {
        "method": "GET",
        "description": "",
        "url": {
          "raw": "{{baseUrl}}/api/v1/deployments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "deployments"
          ],
          "query": [],
          "variable": []
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.margo.manifest.v1+json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.environment.set('manifestVersion', body.manifestVersion);",
              "if (pm.response.headers.get('ETag')) { pm.environment.set('manifestEtag', pm.response.headers.get('ETag')); }",
              "if (body.deployments && body.deployments.length > 0) {",
              "    pm.environment.set('deploymentId', body.deployments[0].deploymentId);",
              "    pm.environment.set('deploymentDigest', body.deployments[0].digest);",
              "}",
              "if (body.bundle) { pm.environment.set('bundleDigest', body.bundle.digest); }"
            ]
          }
        }
      ],
      "response": [],
      "crIds": [
        "MARGO-WFM-MANAGEMENTINTERFACE-023"
      ],
      "expected_status": 200
    },
