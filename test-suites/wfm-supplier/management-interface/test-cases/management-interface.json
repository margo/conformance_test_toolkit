  {
    "id": "wfm-core-desired-state",
    "name": "Desired State — Retrieval, Content Negotiation, Digest-Addressed Fetches",
    "crIds": [
      "MARGO-WFM-MGMT-031",
      "MARGO-WFM-MGMT-032",
      "MARGO-WFM-MGMT-033",
      "MARGO-WFM-MGMT-034",
      "MARGO-WFM-MGMT-035",
      "MARGO-WFM-MGMT-037",
      "MARGO-WFM-MGMT-038",
      "MARGO-WFM-MGMT-045",
      "MARGO-WFM-MGMT-058",
      "MARGO-WFM-MGMT-059",
      "MARGO-WFM-MGMT-060",
      "MARGO-WFM-MGMT-084",
      "MARGO-WFM-MGMT-085",
      "MARGO-WFM-MGMT-086"
    ],
    "description": "The desired-state manifest: served with and without an Accept header, with a quoted sha256 ETag and without `immutable` caching; `bundle` is null exactly when there are no deployments; a conditional request with the current ETag is answered 304.",
    "steps": [
      {
        "id": "wfm-core-ds-1",
        "name": "Retrieve Desired State With Explicit Accept Header — Content-Type And ETag Format",
        "crIds": [
          "MARGO-WFM-MGMT-032",
          "MARGO-WFM-MGMT-033",
          "MARGO-WFM-MGMT-058",
          "MARGO-WFM-MGMT-085"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          },
          {
            "field": "_headers.content-type",
            "operation": "equals",
            "value": "application/vnd.margo.manifest.v1+json"
          },
          {
            "field": "_headers.etag",
            "operation": "matches_regex",
            "value": "^\"sha256:[0-9a-f]{64}\"$"
          }
        ],
        "extract_context": {
          "manifestEtag": "_headers.etag",
          "bundleDigest": "bundle.digest",
          "deploymentId": "deployments.0.deploymentId",
          "deploymentDigest": "deployments.0.digest"
        }
      },
      {
        "id": "wfm-core-ds-manifest-version",
        "name": "Desired State: manifestVersion Is A Positive Integer",
        "crIds": [
          "MARGO-WFM-MGMT-034"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "is_number"
          },
          {
            "field": "manifestVersion",
            "operation": "matches_regex",
            "value": "^[1-9][0-9]*$"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "wfm-core-ds-version-sequence",
        "name": "A Changed State Manifest Has A Strictly Greater manifestVersion (compared with the previous run)",
        "crIds": [
          "MARGO-WFM-MGMT-035"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [],
        "extract_context": {},
        "manifest_history": true
      },
      {
        "id": "wfm-core-ds-deployments-array",
        "name": "Desired State: deployments Is An Array",
        "crIds": [
          "MARGO-WFM-MGMT-045"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "deployments",
            "operation": "is_array"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "wfm-core-ds-bundle-field",
        "name": "Desired State: bundle Is null Exactly When There Are No Deployments",
        "crIds": [
          "MARGO-WFM-MGMT-037",
          "MARGO-WFM-MGMT-038",
          "MARGO-WFM-MGMT-084"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "operation": "bundle_null_iff_no_deployments"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "wfm-core-ds-not-immutable",
        "name": "Desired State Manifest Is Not Marked immutable",
        "crIds": [
          "MARGO-WFM-MGMT-086"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.cache-control",
            "operation": "not_contains",
            "value": "immutable"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "wfm-core-ds-cache-private",
        "name": "Desired State Manifest Is Marked Cache-Control: private",
        "crIds": [
          "MARGO-WFM-MGMT-059"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.cache-control",
            "operation": "contains",
            "value": "private"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "wfm-core-ds-2",
        "name": "Retrieve Desired State Without An Accept Header — Defaults To Manifest Media Type",
        "crIds": [
          "MARGO-WFM-MGMT-031"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {},
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.content-type",
            "operation": "equals",
            "value": "application/vnd.margo.manifest.v1+json"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "wfm-core-ds-3",
        "name": "Retrieve Desired State Again With Matching ETag — 304",
        "crIds": [
          "MARGO-WFM-MGMT-060"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json",
          "If-None-Match": "{manifestEtag}"
        },
        "expected_status": 304,
        "validations": [],
        "extract_context": {}
      }
    ]
  },
  {
    "id": "wfm-core-content-negotiation",
