  {
    "id": "wfm-core-status",
    "name": "Deployment Status Reporting",
    "crIds": [
      "MARGO-WFM-MGMT-001"
    ],
    "description": "A status report for a deployment ID the WFM did not assign. The specification leaves the answer open, so the report may be accepted (200/201) or rejected as a semantic error (422); a server error or any other answer fails.",
    "steps": [
      {
        "id": "wfm-core-status-1",
        "name": "Status For A Deployment The WFM Did Not Assign — Accepted, Or Rejected As A Semantic Error (never a server error)",
        "method": "POST",
        "endpoint": "/api/v1/deployments/wfm-core-test-deployment/status",
        "mtls": true,
        "request_body": {
          "deploymentId": "wfm-core-test-deployment",
          "adoptedManifestVersion": 1,
          "status": {
            "state": "installed"
          },
          "components": [
            {
              "name": "wfm-core-component-1",
              "state": "installed"
            }
          ]
        },
        "headers": {},
        "expected_status": 200,
        "accepted_statuses": [
          201,
          422
        ],
        "validations": [],
        "extract_context": {},
        "crIds": [
          "MARGO-WFM-MGMT-001"
        ]
      }
    ]
  },
  {
    "id": "wfm-header-integrity-manifest",
    "name": "Desired State Manifest — ETag & Content-Type Correctness",
    "description": "Headers of the desired-state manifest: Content-Type, a quoted sha256 ETag that is the digest of the exact response body, the same ETag on a second read, and 304 with an empty body for a conditional request.",
    "crIds": [
      "MARGO-WFM-MGMT-032",
      "MARGO-WFM-MGMT-033",
      "MARGO-WFM-MGMT-057",
      "MARGO-WFM-MGMT-058",
      "MARGO-WFM-MGMT-060",
      "MARGO-WFM-MGMT-085",
      "MARGO-WFM-MGMT-089"
    ],
    "steps": [
      {
        "id": "step-wfm-hi-1.1",
        "name": "Get Deployments — Manifest Has ETag, Content-Type, and a Valid Version",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "greater_than",
            "value": 0
          },
          {
            "field": "_headers.content-type",
            "operation": "equals",
            "value": "application/vnd.margo.manifest.v1+json"
          },
          {
            "field": "_headers.etag",
            "operation": "exists"
          },
          {
            "field": "_headers.etag",
            "operation": "matches_regex",
            "value": "^\"sha256:[0-9a-f]{64}\"$"
          }
        ],
        "extract_context": {
          "etag": "_headers.etag"
        },
        "crIds": [
          "MARGO-WFM-MGMT-032",
          "MARGO-WFM-MGMT-033",
          "MARGO-WFM-MGMT-058",
          "MARGO-WFM-MGMT-085"
        ]
      },
      {
        "id": "step-wfm-hi-1.2",
        "name": "Get Deployments Again With If-None-Match — Returns 304 With Empty Body",
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json",
          "If-None-Match": "{etag}"
        },
        "expected_status": 304,
        "validations": [
          {
            "field": "_body",
            "operation": "equals",
            "value": ""
          }
        ],
        "extract_context": {},
        "crIds": [
          "MARGO-WFM-MGMT-060"
        ]
      },
      {
        "id": "step-wfm-hi-1.3",
        "name": "Manifest ETag Is The sha256 Digest Of The Exact Response Body",
        "crIds": [
          "MARGO-WFM-MGMT-057"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "operation": "etag_is_body_digest"
          }
        ],
        "extract_context": {}
      },
      {
        "id": "step-wfm-hi-1.4",
        "name": "Manifest ETag Is Unchanged On A Second Read",
        "crIds": [
          "MARGO-WFM-MGMT-089"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "_headers.etag",
            "operation": "equals",
            "value": "{etag}"
          }
        ],
        "extract_context": {}
      }
    ]
  },
  {
    "id": "wfm-caller-scope",
    "name": "Management Interface — Caller Scope (another client sees none of the CTT client's resources)",
    "crIds": [
      "MARGO-WFM-MGMT-001",
      "MARGO-WFM-MGMT-016",
      "MARGO-WFM-MGMT-036"
    ],
    "description": "A second accepted client of the same WFM must not see the deployment assigned to the CTT's client: it is not in its State Manifest, and its deployment YAML and bundle URLs answer 404. NOT RUN without second-client-svid-cert.pem / -key.pem in the cert folder, or when the WFM does not accept that client.",
    "steps": [
      {
        "id": "wfm-scope-own-manifest",
        "name": "The CTT's Client Has A Deployment Assigned (setup for the scope checks)",
        "crIds": [
          "MARGO-WFM-MGMT-001"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "poll": {
          "interval_seconds": 10,
          "timeout_seconds": 60,
          "until": [
            {
              "field": "deployments",
              "operation": "array_length_gte",
              "value": 1
            }
          ],
          "on_timeout": "skip_scenario",
          "skip_reason": "no application deployment is assigned to the CTT's client ({cttClientSpiffeId}), so caller scope was not judged. Assign one (sandbox Symphony: provision-multi-component.sh) and run the group again."
        },
        "validations": [
          {
            "field": "deployments",
            "operation": "array_length_gte",
            "value": 1
          }
        ],
        "extract_context": {
          "deploymentId": "deployments.0.deploymentId",
          "deploymentDigest": "deployments.0.digest",
          "bundleDigest": "bundle.digest"
        }
      },
      {
        "id": "wfm-scope-manifest",
        "name": "Second Client's State Manifest Does Not List The CTT Client's Deployment",
        "crIds": [
          "MARGO-WFM-MGMT-016"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "_body",
            "operation": "not_contains",
            "value": "{deploymentId}"
          }
        ],
        "extract_context": {},
        "svid_source": "second-client",
        "not_run_if": {
          "error": ".",
          "reason": "the WFM refused the second-client SVID at the TLS handshake (it is not an accepted client), so caller scope could not be observed"
        }
      },
      {
        "id": "wfm-scope-first-manifest",
        "name": "First State Manifest Of A Client With No Deployment Has manifestVersion 1",
        "crIds": [
          "MARGO-WFM-MGMT-036"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments",
        "mtls": true,
        "headers": {
          "Accept": "application/vnd.margo.manifest.v1+json"
        },
        "expected_status": 200,
        "validations": [
          {
            "field": "manifestVersion",
            "operation": "equals",
            "value": 1
          }
        ],
        "extract_context": {},
        "svid_source": "second-client",
        "not_run_if": {
          "error": ".",
          "reason": "the WFM refused the second-client SVID at the TLS handshake (it is not an accepted client), so its first manifest could not be read"
        }
      },
      {
        "id": "wfm-scope-deployment",
        "name": "Second Client Cannot Read The CTT Client's Deployment YAML (404)",
        "crIds": [
          "MARGO-WFM-MGMT-016"
        ],
        "method": "GET",
        "endpoint": "/api/v1/deployments/{deploymentId}/{deploymentDigest}",
        "mtls": true,
        "headers": {},
        "expected_status": 404,
        "validations": [],
        "extract_context": {},
        "svid_source": "second-client",
        "not_run_if": {
          "error": ".",
          "reason": "the WFM refused the second-client SVID at the TLS handshake (it is not an accepted client), so caller scope could not be observed"
        }
      },
      {
        "id": "wfm-scope-bundle",
        "name": "Second Client Cannot Read The CTT Client's Bundle (404)",
        "crIds": [
          "MARGO-WFM-MGMT-016"
        ],
        "method": "GET",
        "endpoint": "/api/v1/bundles/{bundleDigest}",
        "mtls": true,
        "headers": {},
        "expected_status": 404,
        "validations": [],
        "extract_context": {},
        "svid_source": "second-client",
        "not_run_if": {
          "error": ".",
          "reason": "the WFM refused the second-client SVID at the TLS handshake (it is not an accepted client), so caller scope could not be observed"
        }
      }
    ]
  },
