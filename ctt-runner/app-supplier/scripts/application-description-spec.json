{
  "apiVersion": {
    "type": "string",
    "required": true,
    "enum": [
      "v1"
    ],
    "displayName": "apiVersion",
    "expected": "v1"
  },
  "id": {
    "type": "string",
    "required": true,
    "regex": "^[a-z0-9-]{1,200}$",
    "displayName": "id",
    "expected": "lowercase letters, numbers and dashes only, max length=200"
  },

  "metadata.name": {
    "type": "string",
    "required": true,
    "displayName": "metadata.name",
    "expected": "Required (non-empty)"
  },

  "metadata.version": {
    "type": "string",
    "required": true,
    "displayName": "metadata.version",
    "expected": "Required (non-empty)"
  },

  "metadata.catalog.organization": {
    "type": "array",
    "required": true,
    "minItems": 1,
    "displayName": "metadata.catalog.organization",
    "expected": "At least one organization"
  },

  "metadata.catalog.organization.name": {
    "type": "string",
    "required": true,
    "displayName": "metadata.catalog.organization.name",
    "expected": "Required (non-empty)"
  },

  "deploymentProfiles": {
    "type": "array",
    "required": true,
    "minItems": 1,
    "displayName": "deploymentProfile",
    "expected": "At least one deployment profile"
  },

  "deploymentProfiles.type": {
    "type": "string",
    "required": true,
    "enum": [
  "helm",
  "compose",
  "custom"
],
    "displayName": "deploymentProfile.type",
    "expected": "helm | compose | custom"
  },

  "deploymentProfiles.id": {
    "type": "string",
    "required": true,
    "displayName": "deploymentProfile.id",
    "expected": "Required (non-empty)"
  },

  "deploymentProfiles.components": {
    "type": "array",
    "required": true,
    "minItems": 1,
    "displayName": "component",
    "expected": "At least one component definition"
  },

  "deploymentProfiles.components.name": {
    "type": "string",
    "required": true,
    "regex": "^[a-z0-9-]+$",
    "displayName": "component.name",
    "expected": "Required (non-empty)"
  },

  "deploymentProfiles.components.properties": {
    "type": "map",
    "required": true,
    "displayName": "properties",
    "expected": "Component properties required"
  },

"deploymentProfiles.components.properties.repository": {
  "type": "string",
  "required": true,
  "displayName": "repository",
  "expected": "Repository URL required"
},

"configuration.schema.name": {
  "type": "string",
  "required": true,
  "parent": "configuration.schema",
  "displayName": "schema",
  "expected": "Schema name required"
},

"configuration.schema.dataType": {
  "type": "string",
  "required": true,
  "parent": "configuration.schema",
  "displayName": "schema.dataType",
  "expected": "Schema data type required",
  "enum": [
    "string",
    "integer",
    "double",
    "boolean",
    "array[string]",
    "array[integer]",
    "array[double]",
    "array[boolean]"
  ]
},

"configuration.sections.settings.parameter": {
  "type": "reference",
  "parent": "configuration.sections.settings",
  "reference": "parameters",
  "displayName": "setting.parameter",
  "expected": "Must match a parameter definition"
},

"configuration.sections.settings.schema": {
  "type": "reference",
  "parent": "configuration.sections.settings",
  "reference": "configuration.schema",
  "displayName": "setting.schema",
  "expected": "Must match a schema definition"
},

"parameters.targets.components": {
  "type": "reference",
  "parent": "parameters.targets",
  "reference": "deploymentProfiles.components.name",
  "displayName": "parameter.target.component",
  "expected": "Must match a deployment component"
},

"parameters.targets.pointer": {
  "type": "string",
  "required": true,
  "parent": "parameters.targets",
  "displayName": "parameter.target.pointer",
  "expected": "Required (non-empty)"
},

"deploymentProfiles.deviceConstraints.capacityRequirements.cpu.cores": {
  "type": "number",
  "required": true,
  "parent": "deploymentProfiles.deviceConstraints.capacityRequirements.cpu",
  "displayName": "cpu.cores",
  "expected": "Required when cpu is present"
},
"propertySelector.matchExpressions.key": {
  "type": "string",
  "required": true,
  "parent": "propertySelector.matchExpressions",
  "regex": "^/.*",
  "displayName": "propertySelector.key",
  "expected": "RFC6901 JSON Pointer"
},
"propertySelector.matchExpressions": {
  "type": "array",
  "required": true,
  "parent": "propertySelector",
  "minItems": 1
},
"matchExpressions.key": {
  "type": "string",
  "required": true,
  "parent": "matchExpressions"
},
"matchExpressions.operator": {
  "type": "string",
  "required": true,
  "parent": "matchExpressions",
  "enum": [
    "In",
    "NotIn",
    "Exists",
    "DoesNotExist",
    "Gt",
    "Lt",
    "ContainsAll",
    "ContainsAny"
  ]
},
"configuration.sections.name": {
  "type": "string",
  "required": true,
  "parent": "configuration.sections",
  "displayName": "configuration.section.name",
  "expected": "Required (non-empty)"
},
"configuration.sections.settings": {
  "type": "array",
  "required": true,
  "parent": "configuration.sections",
  "minItems": 1,
  "displayName": "configuration.section.settings",
  "expected": "At least one setting"
},
"parameters.targets": {
  "type": "array",
  "required": true,
  "parent": "parameters",
  "minItems": 1,
  "displayName": "parameter.targets",
  "expected": "At least one target"
},
"matchExpressions.in-notin.values": {
  "type": "operatorValidation",
  "operator": ["In","NotIn"],
  "valueType": ["string","number","boolean"],
  "allowSingleBoolean": true,
  "minItems": 1
},
"matchExpressions.in-notin.sameType": {
  "type": "operatorValidation",
  "operator": ["In","NotIn"],
  "sameType": true
},
"matchExpressions.gtlt.numeric": {
  "type": "operatorValidation",
  "operator": ["Gt","Lt"],
  "numeric": true
},
"deploymentProfiles.components.properties.revision": {
  "type": "string",
  "required": true,
  "displayName": "revision",
  "regex": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:[_+]([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
},
"configuration.schema.options": {
  "requiredWhen": {
      "validationType": "select"
  },
  "minItems": 1
}
}