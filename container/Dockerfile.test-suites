# CTT test-suites image: only the test-suites folder.
# When it runs, it copies the test-suites into the shared volume that the
# runner container mounts at /ctt/test-suites, then exits.
#
# Build from the repository root:
#   docker build -f container/Dockerfile.test-suites -t margo-ctt-test-suites:dev .

FROM busybox:1.36.1

COPY test-suites /test-suites

CMD ["sh", "-c", "rm -rf /shared/* && cp -a /test-suites/. /shared/ && echo 'test-suites copied to the shared volume'"]
