# CTT runner image: the CTT code and scripts, every tool they call, and the
# CTT's own OCI registry (Zot). The test-suites are NOT in this image; they come
# from the test-suites image (Dockerfile.test-suites) through a shared volume.
#
# Build from the repository root:
#   docker build -f container/Dockerfile.runner -t margo-ctt-runner:dev .

FROM golang:1.24.4 AS go

FROM ubuntu:24.04

# Pinned tool versions, verified by SHA-256 at build time.
ARG ZOT_VERSION=v2.1.22
ARG ZOT_SHA256=a053169f97b4ceaa051e054d53971799188a398cb36acbaf5e08622ec8664c44
ARG ORAS_VERSION=1.3.4
ARG ORAS_SHA256=f27adb935022d94df8dc77719c322dda592c78a0d57a6f7dcdd8d900b248c454

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/usr/local/go/bin:/root/go/bin:$PATH

# OS packages: the CTT prerequisites (jq, openssl, node/npm), htpasswd for Zot,
# sudo (the scripts call it; the container runs as root), and the native
# libraries WeasyPrint needs for the signed PDF report (same list as pdf_ops.sh).
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash ca-certificates curl git jq openssl sudo apache2-utils \
        nodejs npm \
        python3 python3-venv python3-pip \
        libpango-1.0-0 libpangocairo-1.0-0 libcairo2 libgdk-pixbuf2.0-0 \
        libffi-dev shared-mime-info libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Go toolchain (the app-supplier module needs Go 1.24; Ubuntu 24.04 ships 1.22).
COPY --from=go /usr/local/go /usr/local/go

# Newman (WFM Supplier Postman groups).
RUN npm install -g newman newman-reporter-htmlextra && npm cache clean --force

# ORAS CLI.
RUN curl -fsSLo /tmp/oras.tar.gz \
        "https://github.com/oras-project/oras/releases/download/v${ORAS_VERSION}/oras_${ORAS_VERSION}_linux_amd64.tar.gz" \
    && echo "${ORAS_SHA256}  /tmp/oras.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/oras.tar.gz -C /usr/local/bin oras \
    && rm /tmp/oras.tar.gz

# Zot registry (minimal binary).
RUN curl -fsSLo /usr/local/bin/zot \
        "https://github.com/project-zot/zot/releases/download/${ZOT_VERSION}/zot-linux-amd64-minimal" \
    && echo "${ZOT_SHA256}  /usr/local/bin/zot" | sha256sum -c - \
    && chmod +x /usr/local/bin/zot

# CTT code and scripts, same layout as the repository: /ctt/ctt-runner,
# /ctt/ctt-creator; /ctt/test-suites is mounted from the test-suites volume.
WORKDIR /ctt
COPY ctt-runner ./ctt-runner
COPY ctt-creator ./ctt-creator
COPY README.md LICENSE ./
RUN mkdir -p /ctt/test-suites

# Download the Go modules now, so the Device and Application Supplier flows
# do not need the internet at run time.
RUN cd ctt-runner/device-supplier && go mod download \
    && cd ../app-supplier && go mod download

# PDF signing tools, installed the way pdf_ops.sh would on its first run
# (venv + Python packages + emoji font). pdf_ops.sh reuses them as they are.
RUN python3 -m venv ctt-runner/reports/scripts/.venv \
    && ctt-runner/reports/scripts/.venv/bin/pip install --no-cache-dir \
        weasyprint pyhanko cryptography pikepdf \
    && mkdir -p ctt-runner/reports/scripts/fonts \
    && curl -fsSLo ctt-runner/reports/scripts/fonts/NotoColorEmoji.ttf \
        https://github.com/googlefonts/noto-emoji/raw/main/2D/fonts/NotoColorEmoji.ttf

COPY container/zot-config.json /etc/zot/config.json
COPY container/entrypoint.sh /usr/local/bin/ctt-entrypoint
RUN chmod +x /usr/local/bin/ctt-entrypoint

# 5443: Zot registry. 3001: mock WFM of the Device Supplier persona.
EXPOSE 5443 3001
ENTRYPOINT ["ctt-entrypoint"]
