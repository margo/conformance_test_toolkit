# ── Generated test-run output — never commit ────────────────────────────
# HTML conformance reports (device + wfm suites)
Runner/**/*.html
*/reports/*.html
wfm-supplier/wfm-test-report*.html
wfm-supplier/wfm-scenario-report*.html

# Per-run device certificates the harness regenerates on every run
# (the CA cert is kept — it's the WFM's, not regenerated)
**/newman-data/certs/device.key
**/newman-data/certs/device-cert.pem

# Runtime / temp scratch files
wfm-supplier/.collection*.json
wfm-supplier/tmp/
**/.temp-fresh.*
device-supplier/device-scenarios/test-scenarios.json

# Compiled test binaries dropped in the working dir
device-supplier/device-supplier
device-supplier/server

# device-supplier runtime output created by ctt-start.sh — never commit.
# certs holds the MIS-issued SVIDs and their private keys.
ctt-runner/device-supplier/bin/
ctt-runner/device-supplier/certs
ctt-runner/device-supplier/data/
ctt-runner/device-supplier/manifests
ctt-runner/device-supplier/sample-apps
ctt-runner/device-supplier/device-scenarios/
ctt-runner/device-supplier/reports/

# wfm-supplier per-run copies made by ctt-start.sh — never commit.
# svid-key.pem is a copy of the CTT's client SVID private key.
ctt-runner/wfm-supplier/utils/certs/device.key
ctt-runner/wfm-supplier/utils/certs/device-cert.pem
ctt-runner/wfm-supplier/utils/certs/svid-cert.pem
ctt-runner/wfm-supplier/utils/certs/svid-key.pem
ctt-runner/wfm-supplier/utils/certs/svid-ca.pem
